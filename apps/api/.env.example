# ============================================================================
# Digital Sarv API — environment
# Copy to apps/api/.env for local dev. In production every value marked
# [required in production] must be set, otherwise the API refuses to boot.
# ============================================================================

# ---- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000

# ---- Data stores -----------------------------------------------------------
# [required in production]  (docker compose on this machine publishes 27018/6380)
MONGO_URI=mongodb://localhost:27017/digital_sarv
# [required in production]
REDIS_URL=redis://localhost:6379

# ---- Auth ------------------------------------------------------------------
# [required in production] Long random string. Outside development/test it is required too.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Dev only: 1 = return the OTP as `devCode` from /auth/otp/request. Ignored when NODE_ENV=production.
OTP_DEV_CODE=1
# Comma-separated mobiles upserted as admins on every boot (first production login).
ADMIN_PHONES=

# ---- Public URLs (no trailing slash) ---------------------------------------
# [required in production] The web app origin — payment return page is ${WEB_PUBLIC_URL}/app/pay/return
WEB_PUBLIC_URL=http://localhost:5173
# [required in production] The API origin WITHOUT /api — gateway callbacks go to ${API_PUBLIC_URL}/api/payments/...
API_PUBLIC_URL=http://localhost:3000
# Comma-separated allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# ---- HTTP hardening ----------------------------------------------------------
# Max JSON / urlencoded body (uploads are limited separately by UPLOAD_MAX_MB).
BODY_LIMIT=1mb
# Reverse-proxy hops in front of the API (Express `trust proxy`), so throttling sees the real client IP:
# 1 = the bundled nginx only (default), 2 = Caddy / host nginx / CDN + nginx. Also accepts true/false or
# comma-separated trusted IPs/CIDRs (e.g. 172.16.0.0/12,loopback). Too high lets clients spoof their IP;
# too low makes every client share the proxy's IP (one throttle bucket for everyone).
TRUST_PROXY=1
# Per-IP rate limits: THROTTLE_LIMIT requests per THROTTLE_TTL seconds (all routes) and a stricter
# THROTTLE_AUTH_LIMIT per THROTTLE_AUTH_TTL for /api/auth/*. 0 disables a limit.
# Defaults: production 600/60s and 30/60s; otherwise 10000/60s and 1000/60s (never trips dev / e2e).
THROTTLE_TTL=60
THROTTLE_LIMIT=
THROTTLE_AUTH_TTL=60
THROTTLE_AUTH_LIMIT=
# Per-user limit for POST /api/uploads (default: production 20 per 60 s; otherwise 1000).
THROTTLE_UPLOAD_TTL=60
THROTTLE_UPLOAD_LIMIT=

# ---- Payments ----------------------------------------------------------------
# mock | zarinpal. `mock` serves a fake bank page from the API; it is refused in production
# unless PAYMENT_ALLOW_MOCK=1 (e.g. a staging box).
PAYMENT_DRIVER=mock
PAYMENT_ALLOW_MOCK=
# Unpaid gateway orders are cancelled this many minutes after their last payment attempt.
PAYMENT_TIMEOUT_MIN=30
# [required when PAYMENT_DRIVER=zarinpal]
ZARINPAL_MERCHANT_ID=
# 1 = use sandbox.zarinpal.com
ZARINPAL_SANDBOX=1

# ---- Uploads -----------------------------------------------------------------
# local (disk). UPLOAD_DIR is relative to the API working directory; mount a volume in Docker.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=50
# Files are deleted this many days after their order is delivered/cancelled.
UPLOAD_RETENTION_DAYS=30

# ---- SMS ---------------------------------------------------------------------
# log | kavenegar. `log` writes OTPs and notifications to the server log (dev).
SMS_DRIVER=log
# [required when SMS_DRIVER=kavenegar]
SMS_API_KEY=
# Sender line for notifications (optional: account default line).
SMS_SENDER=
# Kavenegar verify/lookup template for OTP ({token} = the code). Without it the OTP is sent as plain text.
SMS_OTP_TEMPLATE=
