# =============================================================================
# Digital Sarv — production environment
# =============================================================================
# cp .env.production.example .env.production   (.env.production is git-ignored)
# Fill in every CHANGE_ME, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# This file is read twice:
#   1. by Docker Compose (--env-file) for ${...} interpolation in docker-compose.prod.yml
#      (mongo/redis credentials, HTTP_PORT, WEB_PUBLIC_URL -> web build arg);
#   2. as the api container's env_file (every line is visible to the NestJS app).
# Format: KEY=value, no quotes, no spaces around "=".
# Generate secrets with:  openssl rand -hex 32
# (hex is URL-safe, so it can be pasted into MONGO_URI / REDIS_URL without percent-encoding)
# =============================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=production
# Port the api listens on inside its container. Keep 3000 — nginx proxies /api/ to api:3000
# (compose pins PORT=3000 for the api service anyway).
PORT=3000

# --- MongoDB ------------------------------------------------------------------
# Root user created on the FIRST start of an empty mongo-data volume (changing these later has no effect;
# rotate with mongosh `db.changeUserPassword` instead).
MONGO_INITDB_ROOT_USERNAME=sarv
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_mongo_password
# Same user/password as above; `mongo` is the compose service name; authSource=admin because it is a root user.
MONGO_URI=mongodb://sarv:CHANGE_ME_mongo_password@mongo:27017/digital_sarv?authSource=admin

# --- Redis --------------------------------------------------------------------
# Passed to redis-server --requirepass.
REDIS_PASSWORD=CHANGE_ME_redis_password
# Empty username, password after the colon, database 0.
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# --- Auth ---------------------------------------------------------------------
# Required in production (the api refuses to boot without it). openssl rand -hex 48
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48
# Token lifetime (vercel/ms format: 7d, 12h, ...)
JWT_EXPIRES_IN=7d
# Comma-separated phones upserted as admins on every boot (09xxxxxxxxx).
ADMIN_PHONES=09120000000
# Never set OTP_DEV_CODE or PAYMENT_ALLOW_MOCK in production.

# --- Public URLs / CORS -------------------------------------------------------
# Origin customers open (no trailing slash). Also baked into the web build as VITE_PUBLIC_URL.
WEB_PUBLIC_URL=https://sarv.example.ir
# Origin that serves /api (same origin as the web behind the bundled nginx). Payment callback:
#   ${API_PUBLIC_URL}/api/payments/zarinpal/callback
API_PUBLIC_URL=https://sarv.example.ir
# Comma-separated allowed browser origins (usually just WEB_PUBLIC_URL, plus www if used).
CORS_ORIGIN=https://sarv.example.ir
# Reverse-proxy hops in front of the api (rate limiting needs the real client IP):
#   1 = nginx only (web container is the edge)   2 = Caddy / host nginx / CDN in front of nginx
# (a CDN in front of Caddy/host nginx adds one more). Also accepts comma-separated trusted CIDRs.
TRUST_PROXY=1

# --- Payments (Zarinpal REST v4) ---------------------------------------------
# mock | zarinpal  (mock is refused in production)
PAYMENT_DRIVER=zarinpal
# 36-char merchant ID from the Zarinpal panel (terminal must be registered for WEB_PUBLIC_URL's domain).
ZARINPAL_MERCHANT_ID=
# 1 = sandbox.zarinpal.com, 0 = live gateway
ZARINPAL_SANDBOX=0

# --- SMS (Kavenegar) ----------------------------------------------------------
# SMS is sent ONLY for the login OTP; order updates go out as in-app + Web Push notifications (below).
# log | kavenegar  (log only prints to the api log — dev)
SMS_DRIVER=kavenegar
# API key from panel.kavenegar.com -> Account -> API key
SMS_API_KEY=
# Sender line (e.g. 10008663); the OTP normally goes through the verify-lookup template below
SMS_SENDER=
# Name of the approved "verify lookup" template used for OTP (see docs/deploy.md)
SMS_OTP_TEMPLATE=sarv-otp

# --- Web Push (order notifications, free — replaces order SMS) ---------------
# Generate once with:  npx web-push generate-vapid-keys   (keep the pair; changing it drops every subscription)
# Leave both keys empty to send in-app notifications only. Setting just one of them fails at boot.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required in production when the keys are set: mailto: or https:// contact for the push services
VAPID_SUBJECT=mailto:admin@sarv.example.ir

# --- Uploads ------------------------------------------------------------------
# local = files on disk (the `uploads` docker volume)
STORAGE_DRIVER=local
# Must match the volume mount in docker-compose.prod.yml (compose pins it too).
UPLOAD_DIR=/data/uploads
# Per-file limit in MB (nginx allows 55m request bodies on /api/).
UPLOAD_MAX_MB=50

# --- Docker Compose only (not used by the app) -------------------------------
# Host binding for the web/nginx container. 80 when nginx is the edge;
# 127.0.0.1:8080 when Caddy / a host reverse proxy terminates TLS in front.
HTTP_PORT=80
# Image tag for digital-sarv/{api,web} (see "Updates & rollback" in docs/deploy.md)
IMAGE_TAG=latest
# Domain for the optional Caddy service (automatic HTTPS)
# DOMAIN=sarv.example.ir
