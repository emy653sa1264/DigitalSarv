# Normalise line endings in the repo; keep LF in files that run inside Linux containers.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Caddyfile text eol=lf
.env* text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
